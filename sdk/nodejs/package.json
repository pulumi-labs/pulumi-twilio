{
    "name": "@pulumi-labs/twilio",
    "version": "0.0.1-dev",
    "description": "Experimental: manage Twilio as infrastructure with Pulumi: subaccounts, API keys, phone-number webhooks, TwiML applications, messaging and Verify services, SIP trunking and BYOC, Event Streams, Serverless services and more.",
    "keywords": [
        "pulumi",
        "twilio",
        "communications",
        "sms",
        "voice",
        "category/network"
    ],
    "homepage": "https://www.twilio.com",
    "repository": "https://github.com/pulumi-labs/pulumi-twilio",
    "license": "Apache-2.0",
    "scripts": {
        "build": "tsc && cp package.json bin/"
    },
    "dependencies": {
        "@pulumi/pulumi": "^3.142.0"
    },
    "devDependencies": {
        "@types/node": "^20",
        "typescript": "^4.7.0"
    },
    "pulumi": {
        "resource": true,
        "name": "twilio",
        "version": "0.0.1-dev",
        "server": "github://api.github.com/pulumi-labs/pulumi-twilio"
    },
    "main": "bin/index.js",
    "types": "bin/index.d.ts",
    "files": [
        "bin/"
    ]
}
