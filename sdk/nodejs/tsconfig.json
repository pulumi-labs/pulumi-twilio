{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "apiKey.ts",
        "application.ts",
        "config/index.ts",
        "config/vars.ts",
        "getAccount.ts",
        "getApiKey.ts",
        "getApplication.ts",
        "getBalance.ts",
        "getIncomingPhoneNumber.ts",
        "getMessagingService.ts",
        "getMessagingServicePhoneNumber.ts",
        "getSubaccount.ts",
        "getVerifyService.ts",
        "incomingPhoneNumber.ts",
        "index.ts",
        "messagingService.ts",
        "messagingServicePhoneNumber.ts",
        "provider.ts",
        "subaccount.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts",
        "verifyService.ts"
    ]
}
